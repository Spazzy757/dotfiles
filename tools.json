{
  "kubectl": {
    "version": "v1.32.1",
    "url": "https://dl.k8s.io/release/{version}/bin/linux/{arch}/kubectl"
  },
  "helm": {
    "version": "v3.17.0",
    "url": "https://get.helm.sh/helm-{version}-linux-{arch}.tar.gz",
    "extract": "linux-{arch}/helm"
  },
  "k9s": {
    "version": "v0.51.0",
    "url": "https://github.com/derailed/k9s/releases/download/{version}/k9s_Linux_{arch}.tar.gz",
    "extract": "k9s"
  },
  "stern": {
    "version": "v1.35.0",
    "url": "https://github.com/stern/stern/releases/download/{version}/stern_{ver}_linux_{arch}.tar.gz",
    "extract": "stern"
  },
  "nvim": {
    "version": "v0.12.6",
    "url": "https://github.com/neovim/neovim/releases/download/{version}/nvim-linux-{uname_arch}.tar.gz",
    "dir": true,
    "bin": "bin/nvim"
  },
  "ghostty": {
    "version": "1.3.1",
    "deb": "https://github.com/mkasberg/ghostty-ubuntu/releases/download/{version}-0-ppa2/ghostty_{version}-0.ppa2_{arch}_{os_version}.deb"
  },
  "nvm":     { "version": "v0.40.1", "git": "https://github.com/nvm-sh/nvm" },
  "pyenv":   { "version": "v2.8.15", "git": "https://github.com/pyenv/pyenv" },
  "jenv":    { "version": "0.6.0",   "git": "https://github.com/jenv/jenv" },
  "bash_it": { "version": "v3.2.0",  "git": "https://github.com/Bash-it/bash-it" },

  "terraform": { "version": "1.15.6" },
  "rust":      { "version": "1.84.0" },
  "bun":       { "version": "1.3.14" }
}
